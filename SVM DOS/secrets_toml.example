# Copy to .streamlit/secrets.toml for local runs. On Streamlit Cloud paste these into Settings -> Secrets.
# NEVER commit the real secrets.toml.

# --- Chatbot answers: set ONE of the two keys below --------------------------------------------
# Gemini (free tier, no billing account needed). Create the key in Google AI Studio from a project
# with NO billing account attached, otherwise usage is charged.
GEMINI_API_KEY = "AQ.Ab8RN6IFEkNtVkTd4Rbf0VhZpTVuFtkbQ4ofPJL-JNSEbcL_Bw"           # chatbot answers (without any key the chatbot shows matching passages only)
# GEMINI_MODEL = "gemini-3.5-flash-lite"   # optional: pick a free-tier model listed in AI Studio

# Claude (paid, optional alternative). Used only if no Gemini key is set, unless LLM_PROVIDER forces it.
# ANTHROPIC_API_KEY = "sk-ant-..."
# CLAUDE_MODEL = "claude-haiku-5-5"
# LLM_PROVIDER = "gemini"            # optional: force "gemini" or "anthropic" when both keys are set

# --- Other settings ---------------------------------------------------------------------------
# ADMIN_PASSWORD = "choose-a-password"   # locks add/remove-source controls on a public app
# GOOGLE_API_KEY = "..."                 # Gemini helper on the weather page (the chatbot also accepts it
#                                        # if GEMINI_API_KEY is not set, so one key can serve both)
